# Auth (required)
AUTH_USERS=Field@waters.com:Empower@123|Test@waters.com:Empower@123
AUTH_SECRET=replace-with-a-long-random-secret-32chars

# AI provider: openrouter | openai
AI_PROVIDER=openrouter

# OpenRouter (required when AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_SITE_URL=https://your-app.vercel.app
OPENROUTER_APP_NAME=Empower CF Studio

# OpenAI (required when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Cost / generation controls
MODEL_TEMPERATURE=0.2
OPENAI_MAX_OUTPUT_TOKENS=2000
DAILY_CHAT_LIMIT=30
