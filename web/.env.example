# Auth (required)
AUTH_USERS=Field@waters.com:Empower@123|Test@waters.com:Empower@123
AUTH_SECRET=replace-with-a-long-random-secret-32chars

# AI provider: openai | openrouter
# Leave blank to auto-select from whichever key is set (prefers OPENAI_API_KEY).
AI_PROVIDER=openai

# OpenAI (used when AI_PROVIDER=openai, or auto when only this key is set)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# OpenRouter (used when AI_PROVIDER=openrouter, or auto when only this key is set)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_SITE_URL=https://your-app.vercel.app
OPENROUTER_APP_NAME=Empower CF Studio

# Cost / generation controls
MODEL_TEMPERATURE=0.2
OPENAI_MAX_OUTPUT_TOKENS=2000
DAILY_CHAT_LIMIT=30
